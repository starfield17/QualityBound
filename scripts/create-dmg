#!/bin/bash

set -euo pipefail

if [[ "$#" -lt 2 ]]; then
    printf 'Usage: create-dmg [options] output.dmg source-folder\n' >&2
    exit 2
fi

arguments=("$@")
output_path=""
source_path=""
for ((index = 0; index < ${#arguments[@]} - 1; index++)); do
    if [[ "${arguments[$index]}" == *.dmg ]]; then
        output_path="${arguments[$index]}"
        source_path="${arguments[$(( index + 1 ))]}"
        break
    fi
done

if [[ -z "$output_path" || -z "$source_path" ]]; then
    printf 'Could not locate output DMG and source folder in arguments.\n' >&2
    exit 2
fi

# Nuitka invokes create-dmg with the temporary standalone directory as the
# source argument. In app-dist mode the normalized .app is its sibling.
if [[ "$source_path" == *.dist && -d "${source_path%.dist}.app" ]]; then
    source_path="${source_path%.dist}.app"
fi

if [[ ! -d "$source_path" ]]; then
    printf 'DMG source directory not found: %s\n' "$source_path" >&2
    exit 1
fi

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
temporary_root="${TMPDIR:-$project_root/workdir/tmp}"
mkdir -p "$temporary_root"
temporary_dir="$(mktemp -d "$temporary_root/qualitybound-dmg.XXXXXXXX")"
temporary_path="$temporary_dir/image.dmg"
staging_dir="$temporary_dir/root"
hdiutil_stderr="$temporary_dir/hdiutil.stderr"
cleanup() {
    rm -rf "$temporary_dir"
}
trap cleanup EXIT

mkdir "$staging_dir"
/usr/bin/ditto "$source_path" "$staging_dir/$(basename "$source_path")"
/bin/ln -s /Applications "$staging_dir/Applications"

set +e
/usr/bin/hdiutil create \
    -volname "$(basename "$source_path" .app)" \
    -srcfolder "$staging_dir" \
    -ov \
    -format UDZO \
    "$temporary_path" 2>"$hdiutil_stderr"
hdiutil_status=$?
set -e

if [[ "$hdiutil_status" -ne 0 ]]; then
    cat "$hdiutil_stderr" >&2
    exit "$hdiutil_status"
fi

# macOS 26 deprecates this hdiutil form and prints that notice even though the
# image was created. Nuitka escalates any create-dmg stderr into a fatal build
# error, so the notice stays visible in stdout while genuine diagnostics keep the
# error stream and a non-zero exit.
if [[ -s "$hdiutil_stderr" ]]; then
    grep -v "is deprecated" "$hdiutil_stderr" >&2 || true
    grep "is deprecated" "$hdiutil_stderr" || true
fi

rm -f "$output_path"
mv "$temporary_path" "$output_path"
